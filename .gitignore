# Environment
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS
.DS_Store

# Frontend build artifacts / deps (reproducible via npm install / npm run build)
frontend/node_modules/
frontend/.next/
frontend/out/

# Misc local caches (geocoding/API response cache, regenerated on demand)
cache/

# Trained model binaries (regenerated in seconds via src/shap_rent.py)
models/*.pkl

# Raw data is INCLUDED so the project runs standalone on a fresh clone
# (no internet-dependent re-download needed). Only truly unused/orphaned files excluded.
data/raw/india_rent.csv
data/raw/osm/*
!**/.gitkeep
